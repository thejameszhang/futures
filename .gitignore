# artifacts (not source) — LEADING SLASH anchors each to the repo root, so
# e.g. /validation/ ignores only the top-level output dir, NOT the tracked
# code under src/globalmacro/validation/. (Unanchored `validation/` would match
# at any depth and silently re-ignore the code.)
/data/
/datasets/
/characteristics/
/validation/
/analysis/
/docs/
/figures/
# validation output artifacts co-located with tracked validation .py code
# (build repoints VALIDATION_OUTPUT to the ignored /validation/ later; these
#  stale/interim outputs live in the code dir — ignore them, keep the code tracked)
src/globalmacro/validation/*.pdf
src/globalmacro/validation/*.txt
src/globalmacro/validation/datastream_comparison/
src/analysis/validation/
# confidential external validation plugin — never commit
src/globalmacro/validation/external_comparison.py
# Tier 2 onboarding gate -- the owner's local harness for accepting a new
# Tier 2 asset (spikes, gaps, coverage, splice integrity). Deliberately
# local-only: not for other researchers to add assets with, and not
# something we want to maintain as shared, reviewed infrastructure. Stays
# on the owner's disk, untracked; contact the owner to add an asset.
scripts/gate_tier2_asset.py
src/globalmacro/validation/asset_quality.py
tests/test_asset_quality.py
tests/test_gate_tier2_asset.py
.DS_Store
.env
.claude/
.superpowers/
assetlist.pdf
AGENTS.md
CLAUDE.md
/slurm/logs/
reference/
old-data/
# methodology docs — intentionally untracked here, not an oversight. Their
# history lives on the local productionize / docs branches. Ignoring a path
# does NOT stop tracked files arriving via a merge, so merge those branches
# into master only with --squash, never plain.
/documentation/
