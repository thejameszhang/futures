# Repo root (defaults to the dir containing pyproject.toml; override if needed)
# FUTURES_ROOT=/path/to/futures
# Data locations (default to repo-root data/ datasets/ characteristics/ validation/)
# FUTURES_DATA_ROOT=/path/to/futures/data
# FUTURES_DATASETS_ROOT=/path/to/futures/datasets
# FUTURES_CHARACTERISTICS_ROOT=/path/to/futures/characteristics
# FUTURES_VALIDATION_OUTPUT=/path/to/futures/validation
# Vendor sub-paths (default under FUTURES_DATA_ROOT)
# TICKHISTORY_PATH=/path/to/tickhistory
# DATASTREAM_PATH=/path/to/datastream
# COMPUSTAT_PATH=/path/to/comp
